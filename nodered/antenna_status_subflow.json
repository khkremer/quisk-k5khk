        "id": "k5khk_status_parse",
        "type": "function",
        "z": "b09908b927c79022",
        "name": "to JSON object",
        "func": "let s = msg.payload;\nif (Buffer.isBuffer(s)) s = s.toString();\nif (typeof s === 'string') {\n    s = s.trim();\n    // serial framing may strip the closing brace\n    if (s.indexOf('{') === 0 && s.lastIndexOf('}') !== s.length - 1) s += '}';\n    try { s = JSON.parse(s); } catch (e) { s = null; }\n}\nif (!s || typeof s !== 'object' || typeof s.ant1 === 'undefined') {\n    msg.payload = { ant1: false, ant2: false, ant3: false, ok: false };\n} else {\n    msg.payload = { ant1: !!s.ant1, ant2: !!s.ant2, ant3: !!s.ant3, ok: true };\n}\nreturn msg;",
